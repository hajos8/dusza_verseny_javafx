<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>

<AnchorPane id="collectionContainer" fx:id="collectionContainer" prefHeight="720.0" prefWidth="1080.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.dusza.render.GameController">
   <children>
      <Label id="task" fx:id="task" alignment="CENTER" layoutX="245.0" layoutY="33.0" prefHeight="38.0" prefWidth="590.0" textAlignment="CENTER">
         <font>
            <Font size="26.0" />
         </font>
         <textFill>
            <LinearGradient endX="1.0" endY="1.0">
               <stops>
                  <Stop>
                     <color>
                        <Color red="1.0" />
                     </color>
                  </Stop>
                  <Stop offset="1.0">
                     <color>
                        <Color />
                     </color>
                  </Stop>
               </stops>
            </LinearGradient>
         </textFill>
      </Label>
      <ScrollPane id="collectionScroll" fx:id="collectionScroll" layoutX="90.0" layoutY="148.0" maxHeight="400.0" maxWidth="900.0" minHeight="400.0" minWidth="900.0" prefHeight="400.0" prefWidth="900.0" stylesheets="@style.css">
        <content>
          <AnchorPane id="collectionPane" fx:id="collectionPane" maxHeight="400.0" maxWidth="900.0" minHeight="400.0" minWidth="900.0" prefHeight="400.0" prefWidth="900.0">
               <children>
                  <HBox id="collectionHBox" fx:id="collectionHBox" alignment="CENTER" minHeight="190.0" minWidth="900.0" prefHeight="190.0" prefWidth="900.0" AnchorPane.topAnchor="10.0" />
                  <HBox id="deckHBox" fx:id="deckHBox" layoutY="210.0" minHeight="190.0" minWidth="900.0" prefHeight="190.0" prefWidth="900.0" AnchorPane.bottomAnchor="10.0" />
               </children>
            </AnchorPane>
        </content>
      </ScrollPane>
      <MFXButton id="nextButton" fx:id="nextButton" layoutX="440.0" layoutY="600.0" onAction="#handleNextButton" text="Tovább" />
   </children>
</AnchorPane>
